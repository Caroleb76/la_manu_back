model ExtraCost {
  id              String           @id @default(uuid())
  categoryId      String                               // FK (required)
  val             Int?
  interventionId  String

  // Relations
  category     ExtraCostCategory @relation(fields: [categoryId], references: [id])
  intervention Intervention      @relation(fields: [interventionId], references: [id])
  files        File[]

  @@index([categoryId])
  @@map("ExtraCost")
}